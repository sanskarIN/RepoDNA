{
  "name": "repodna-workspace",
  "version": "1.4.3",
  "private": true,
  "description": "Open-source repository intelligence and code archaeology.",
  "license": "Apache-2.0",
  "author": "Sanskar (https://sanskarin.github.io)",
  "homepage": "https://github.com/sanskarIN/RepoDNA",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskarIN/RepoDNA.git"
  },
  "workspaces": [
    "packages/schema",
    "packages/visualization",
    "packages/wasm",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "release:check": "node packaging/release/check-version.mjs",
    "links:check": "node packaging/release/check-support-links.mjs",
    "links:test": "node --test packaging/release/test/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\""
  },
  "devDependencies": {
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
