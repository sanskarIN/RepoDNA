{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoDNA",
  "version": "1.0.0",
  "identifier": "io.github.sanskarin.repodna",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev -w @repodna/web", "cwd": "../.." },
    "beforeBuildCommand": { "script": "npm run build -w @repodna/web", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoDNA",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Repository intelligence and code archaeology",
    "longDescription": "RepoDNA analyzes a repository's structure, architecture, history, dependencies, and health on your machine, and explains every conclusion with the evidence behind it.",
    "copyright": "Copyright 2026 Sanskar",
    "license": "Apache-2.0",
    "homepage": "https://github.com/sanskarIN/RepoDNA",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
